{
  "name": "16 to 19 provider accordion section",
  "type": "AccordionSection",
  "dataset": [
    {
      "datasetName": "providerFunding",
      "expression": "ParentProviderType=AcademyTrust&GroupingReason=Information"
    }
  ],
  "groups": [
    {
      "type": "Accordion/Button",
      "groups": [
        {
          "type": "Accordion/Title",
          "groups": [
            {
              "type": "Accordion/Total",
              "selector": "$.totalValue",
              "datastyle": {
                "numberFormat": "GBCurrencyWithoutTrailingZeroes"
              }
            }
          ]
        },
        {
          "type": "Accordion/SubTitle",
          "groups": [
            {
              "type": "General/ProviderNameWithUrn"
            },
            {
              "type": "Heading/Small",
              "value": "Published: @statusChangedDateUiFormatted"
            }
          ]
        }
      ]
    },
    {
      "type": "Accordion/Panel",
      "classname": "govuk-!-padding-left-6",
      "groups": [
        {
          "type": "Heading/Small",
          "title": "Funding breakdown",
          "classname": "heading-small heading-guidance"
        },
        {
          "type": "Html/Div",
          "classname": "funding-block funding-margin-bottom",
          "groups": [
            {
              "type": "Heading/Medium",
              "classname": "govuk-heading-l",
              "groups": [
                {
                  "type": "General/StandardLink",
                  "title": "View funding breakdown for @providerName",
                  "value": "@loggedInProviderFundingBreakdownPath"
                }
              ]
            }
          ]
        },
        {
          "type": "Block/AllocationHistory",
          "classname": "heading-small heading-guidance"
        },
        {
          "type": "Heading/Small",
          "classname": "heading-small heading-guidance",
          "title": "Explore the topic"
        },
        {
          "type": "Pattern/UnorderedList",
          "classname": "list footer-guidance",
          "groups": [
            {
              "type": "General/Section",
              "groups": [
                {
                  "type": "General/ExternalLink",
                  "value": "https://www.gov.uk/government/publications/16-to-19-funding-allocations-supporting-documents-for-@year1-to-@year2/16-to-19-special-post-16-institution-spi-revenue-funding-allocation-guide-@year1-to-@year2",
                  "title": "@shortFundingStreamNameHtml allocation guides: @year1 to @year2 (opens in new tab)"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "variables": [
    {
      "name": "Methodology",
      "selector": "$..calculations[?(@.templateCalculationId == 44)].value"
    },
    {
      "name": "TreatAsSpecialAcademy",
      "expression": "@Methodology=HNS specials"
    },
    {
      "name": "IsSchool",
      "expression": "@providerType=Schoo"
    }
  ]
}