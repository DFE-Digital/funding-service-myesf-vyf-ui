{
  "name": "FEC provider accordion section",
  "type": "AccordionSection",
  "dataset": [
    {
      "datasetName": "providerFunding",
      "expression": "ParentProviderType=LocalAuthority&GroupingReason=Information"
    }
  ],
  "groups": [
    {
      "type": "Accordion/Button",
      "groups": [
        {
          "type": "Accordion/Title",
          "groups": [
            {
              "type": "Accordion/Total",
              "selector": "$.totalValue"
            }
          ]
        },
        {
          "type": "Accordion/SubTitle",
          "groups": [
            {
              "type": "General/PublishedDate"
            }
          ]
        }
      ]
    },
    {
      "type": "Accordion/Panel",
      "groups": [
        {
          "type": "Heading/Small",
          "classname": "heading-medium",
          "title": "Funding breakdown"
        },
        {
          "type": "Html/Div",
          "classname": "form-block document-list",
          "groups": [
            {
              "type": "Table/Table",
              "classname": "funding-breakdown-pesg",
              "title": "Showing @fundingStreamName for '@providerName'",
              "visuallyhidden": true,
              "groups": [
                {
                  "type": "Table/Columns",
                  "groups": [
                    {
                      "type": "Table/Column",
                      "title": "Local authority code",
                      "classname": "govuk-table__header",
                      "useDefaultClasses": false
                    },
                    {
                      "type": "Table/Column",
                      "title": "Local authority name",
                      "classname": "govuk-table__header",
                      "useDefaultClasses": false
                    },
                    {
                      "type": "Table/Column",
                      "title": "Local authority establishment number (at @asofmonth @asofyear)",
                      "classname": "govuk-table__header",
                      "useDefaultClasses": false
                    },
                    {
                      "type": "Table/Column",
                      "title": "School name (at @asofmonth @asofyear)",
                      "classname": "govuk-table__header",
                      "useDefaultClasses": false
                    },
                    {
                      "type": "Table/Column",
                      "title": "Total allocation",
                      "classname": "govuk-table__header",
                      "useDefaultClasses": false
                    }
                  ]
                },
                {
                  "type": "Table/Rows",
                  "groups": [
                    {
                      "type": "Table/Row",
                      "title": "Unit of funding",
                      "groups": [
                        {
                          "type": "Table/RowColumn",
                          "title": "@laCode",
                          "classname": "table-header-normal",
                          "useDefaultClasses": false
                        },
                        {
                          "type": "Table/RowColumn",
                          "title": "@localAuthorityName",
                          "classname": "table-header-normal",
                          "useDefaultClasses": false
                        },
                        {
                          "type": "Table/RowColumn",
                          "expression": "@providerEstablishmentNumber",
                          "classname": "table-header-normal",
                          "useDefaultClasses": false
                        },
                        {
                          "type": "Table/RowColumn",
                          "title": "@providerName",
                          "classname": "table-header-normal",
                          "useDefaultClasses": false
                        },
                        {
                          "type": "Table/RowColumn",
                          "selector": "$.totalValue",
                          "classname": "table-header-normal",
                          "useDefaultClasses": false,
                          "datastyle": {
                            "numberFormat": "GBCurrencyWithoutTrailingZeroes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Html/Div",
          "attributes": {
              "style": "clear: both"
          }
        }
      ]
    }
  ]
}