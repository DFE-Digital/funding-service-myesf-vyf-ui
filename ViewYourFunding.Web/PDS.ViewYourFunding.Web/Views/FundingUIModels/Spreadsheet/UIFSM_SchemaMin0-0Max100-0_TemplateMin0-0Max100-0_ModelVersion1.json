{
  "name": "UIFSM Provisional Spreadsheet",
  "type": "spreadsheet",
  "classes": {
    "borderAllSides": {
      "style": {
        "borders": [
          {
            "edge": "TopBorder"
          },
          {
            "edge": "BottomBorder"
          },
          {
            "edge": "RightBorder"
          },
          {
            "edge": "LeftBorder"
          }
        ]
      },
      "datastyle": {
        "borders": [
          {
            "edge": "TopBorder"
          },
          {
            "edge": "BottomBorder"
          },
          {
            "edge": "RightBorder"
          },
          {
            "edge": "LeftBorder"
          }
        ]
      }
    },
    "wideHeaderBold": {
      "style": {
        "heightInches": 1,
        "alignment": "centered",
        "widthInches": "2.5",
        "wrap": true,
        "bold": true
      },
      "datastyle": {
        "bold": true
      }
    },
    "headerRow": {
      "style": {
        "alignment": "centered",
        "bold": true
      }
    },
    "wideHeader": {
      "style": {
        "heightInches": 1,
        "alignment": "centered",
        "widthInches": "2.5",
        "wrap": true
      }
    },
    "schoolHeader": {
      "style": {
        "heightInches": 1,
        "alignment": "centered",
        "widthInches": "3.5",
        "wrap": true
      }
    },
    "narrowHeader": {
      "style": {
        "alignment": "centered",
        "heightInches": 1,
        "widthInches": "1",
        "wrap": true
      }
    },
    "mediumHeader": {
      "style": {
        "heightInches": 1.2,
        "alignment": "centered",
        "widthInches": "1.4",
        "wrap": true
      }
    }
  },
  "groups": [
    {
      "id": "listofallschools",
      "title": "All Schools",
      "autofilter": true,
      "autoFilterStartRow": 3,
      "headerRow": "UNIVERSAL INFANT FREE SCHOOL MEALS (UIFSM) - PROVISIONAL REVENUE ALLOCATIONS FOR ACADEMIC YEAR 2022/2023",
      "dataset": [
        {
          "datasetName": "providerfunding",
          "parentGroupingType": "LocalAuthority",
          "orderBy": "ProviderUrn",
          "expression": "(GroupingReason=Information)&(ProviderUrn!=0)"
        }
      ],
      "groups": [
        {
          "title": "",
          "groups": [
            {
              "title": "",
              "groups": [
                {
                  "title": "Unique Reference Number (URN)",
                  "selector": "$..providerUrn",
                  "classname": "headerRow narrowHeader borderAllSides",
                  "datastyle": {
                    "dataType": "Number",
                    "alignment": "left"
                  }
                },
                {
                  "title": "UK Provider Reference Number (UKPRN)",
                  "selector": "$..organisationUkprn",
                  "classname": "headerRow narrowHeader borderAllSides",
                  "datastyle": {
                    "dataType": "Number",
                    "alignment": "left"
                  }
                },
                {
                  "title": "Local Authority Establishment Number (LAEstab)",
                  "selector": "$..organisationDfeNumber",
                  "classname": "headerRow narrowHeader borderAllSides",
                  "datastyle": {
                    "dataType": "Number",
                    "alignment": "left"
                  }
                },
                {
                  "title": "Local Authority Code",
                  "selector": "$..parentPrimaryIdentifier",
                  "classname": "headerRow narrowHeader borderAllSides",
                  "datastyle": {
                    "dataType": "Number",
                    "alignment": "left"
                  }
                },
                {
                  "title": "Local Authority Name",
                  "selector": "$..parentName",
                  "classname": "headerRow mediumHeader borderAllSides"
                },
                {
                  "title": "Establishment Number",
                  "selector": "$..estabNumber",
                  "classname": "headerRow narrowHeader borderAllSides",
                  "datastyle": {
                    "dataType": "Number",
                    "alignment": "left"
                  }
                },
                {
                  "title": "School Name",
                  "selector": "$..organisationName",
                  "classname": "headerRow schoolHeader borderAllSides"
                },
                {
                  "title": "Academy / Mainitained School (as at 1st May @year1)",
                  "selector": "C73",
                  "classname": "headerRow wideHeader borderAllSides"
                },
                {
                  "title": "School Type (taken from GIAS as at 1st May @year1)",
                  "selector": "$..providerSubTypeValue",
                  "classname": "headerRow wideHeader borderAllSides"
                },
                {
                  "title": "Final allocation for @year0-@year1short (@britishCurrencySymbol)",
                  "selector": "C1",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Provisional revenue payment for @year1-@year2short (@britishCurrencySymbol)",
                  "selector": "L2",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Reception pupils from October @year0 census",
                  "selector": "C3",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Reception FSM pupils from October @year0 census",
                  "selector": "C4",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Total Eligible Meals taken by Reception pupils from October @year0 census (Col L - Col M)",
                  "selector": "C5",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Year 1 and Year 2 pupils from October @year0 census",
                  "selector": "C6",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Year 1 and Year 2 FSM pupils from October @year0 census",
                  "selector": "C7",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Total Eligible Meals taken by Year 1 and Year 2 pupils from October @year0 census (Col O - Col P)",
                  "selector": "C8",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Reception pupils from January @year1 census",
                  "selector": "C9",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Reception FSM pupils from January @year1 census",
                  "selector": "C10",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Total Eligible Meals taken by Reception pupils from January @year1 census (Col R - Col S)",
                  "selector": "C11",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Year 1 and Year 2 pupils from January @year1 census",
                  "selector": "C12",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Meals taken by Year 1 and Year 2 FSM pupils from January @year1 census",
                  "selector": "C13",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Total Eligible Meals taken by Year 1 and Year 2 pupils from January @year1 census (Col U - Col V)",
                  "selector": "C14",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0"
                  }
                },
                {
                  "title": "Total Eligible Meals taken by Reception pupils used in @year0-@year1short final allocation calculation",
                  "selector": "C15",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0.0"
                  }
                },
                {
                  "title": "Total Eligible Meals taken by Year 1 and Year 2 pupils used in @year0-@year1short final allocation calculation",
                  "selector": "C16",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0.0"
                  }
                },
                {
                  "title": "Total Eligible Meals taken by Infant pupils used in @year0-@year1short final allocation calculation (Col X + Col Y)",
                  "selector": "C17",
                  "classname": "headerRow wideHeader borderAllSides",
                  "datastyle": {
                    "numberFormat": "#,##0.0"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
