@using Pds.Core.Web.Areas.ErrorPages.Models
@model PDS.ViewYourFunding.Web.Models.Error.ErrorPageViewModel
<div class="form-block">
    <h1 class="heading-xlarge">You do not have access to this page</h1>
</div>
@if (Model.RequiredUserRolesForUrl != null)
{
    <partial name="_StatusCode403DSIRequiredUserRoles" , model='new StatusCode403DsiRequiredUserRolesViewModel { RequiredUserRolesForUrl = Model.RequiredUserRolesForUrl, DfeSignInLink = Model.DfeSignInLink, DfeSignInOrganisationLink = Model.DfeSignInOrganisationLink }' />
}
else
{
    <p>This page is for internal use only.</p>
}