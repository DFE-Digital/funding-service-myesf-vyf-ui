@using PDS.ViewYourFunding.Services.Helper
@using PDS.ViewYourFunding.Services.Enums
@using Models = PDS.ViewYourFunding.Services.Interfaces.Models
@model Models.Component
@{
    if (ComponentHelper.IsEnvironmentReleaseOrPreProd())
    {
        await ComponentHelper.Render(Html, ComponentType.Error_ReleaseError, Model, Model.PageData);
        return;
    }
}

<div style="clear: both"></div>

<div class="componentError">
    @Model.UnevaluatedTitle@* Unevaluated by design *@
</div>