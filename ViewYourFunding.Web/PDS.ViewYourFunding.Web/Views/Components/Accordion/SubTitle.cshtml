@using PDS.ViewYourFunding.Services.Helper
@using PDS.ViewYourFunding.Services.Enums
@using Models = PDS.ViewYourFunding.Services.Interfaces.Models
@model Models.Component

@if (Model.ComponentConfiguration.FundingStreamCode == "GAG")
{
    <div class="govuk-accordion__section-summary-IYO" id="accordion-with-summary-sections-summary-@Model.GetAccordionInstanceNumber()">
        @{
            await ComponentHelper.Render(Html, ComponentType.General_Section, Model, Model.PageData);
        }
    </div>
}
else
{
    <div class="govuk-accordion__section-summary" id="accordion-with-summary-sections-summary-@Model.GetAccordionInstanceNumber()">
        @{
            await ComponentHelper.Render(Html, ComponentType.General_Section, Model, Model.PageData);
        }
    </div>
}