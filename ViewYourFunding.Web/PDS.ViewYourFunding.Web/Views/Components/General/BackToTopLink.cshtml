@using PDS.ViewYourFunding.Services.Helper
@using Models = PDS.ViewYourFunding.Services.Interfaces.Models
@model Models.Component
@{
    var additionalClassNames = Model.ClassNames?.Any() == true ? $"{Model.ClassNames.First()}" : string.Empty;
    var href = Model.GetValueString("#content");
}
<div class="direction-rtl @additionalClassNames">
    <a class="app-c-back-to-top dont-print back-to-top-link" href="@href">
        <svg class="app-c-back-to-top__icon" xmlns="http://www.w3.org/2000/svg" width="13" height="17" viewBox="0 0 13 17">
            <path fill="currentColor" d="M6.5 0L0 6.5 1.4 8l4-4v12.7h2V4l4.3 4L13 6.4z"></path>
        </svg>
        Back to top
    </a>
</div>
