@using PDS.ViewYourFunding.Services.Constants
@using PDS.ViewYourFunding.Web.Helpers
@using PDS.ViewYourFunding.Services.Helper
@using PDS.ViewYourFunding.Services.Enums
@using PDS.ViewYourFunding.Services.ResponseObjects
@using Models = PDS.ViewYourFunding.Services.Interfaces.Models
@model Models.Component
@{
    // https://esfstest.herokuapp.com/component-library/download-a-document

    var componentConfiguration = Model.ComponentConfiguration;
    var document = Model.GetValue() as FundingDocument ?? componentConfiguration.FundingDocument;    
    string indicative = componentConfiguration.IsIndicativeFunding ? "indicative " : string.Empty;
    if (document == null)
    {
        Model.Title = "Error - No document has been generated";
        await ComponentHelper.Render(Html, ComponentType.Error_Error, Model, Model.PageData);
        return;
    }

    var documentId = ComponentHelper.GetAndIncreaseInstanceNumber("_DesignComponents/DownloadADocument", Context);
    var fileExtension = document.FileExtension;
    var fileSizeKb = document.FileSizeBytes.HasValue ? Math.Floor(document.FileSizeBytes.Value / 1024.0).ToString("#,#") : "--";
    var isLatestDocument = document.IsLatestDocument;
    var isFinal = document.IsFinal;

    Model.ClassNames.Insert(0, "form-block");
    Model.ClassNames.Insert(1, "attachment");
    Model.ClassNames.Insert(2, "embedded");


    if (string.IsNullOrEmpty(Model.Title))
    {
        var institutionName = componentConfiguration.IsLocalAuthority ?
            componentConfiguration.LocalAuthorityName : componentConfiguration.ProviderName;

        var nameOrCode = componentConfiguration.ShowNameAbbreviation ?
            componentConfiguration.FundingStreamCode : componentConfiguration.FundingStreamName;

        if (!componentConfiguration.ShowNameAbbreviation && componentConfiguration.IsALoggedInView)
        {
            nameOrCode = nameOrCode?.ToLower();
        }

        Model.Title = $"Download {indicative}{nameOrCode?.ToLower()} allocation for {institutionName} {document.YearFrom} to {document.YearTo}";
    }

    var downloadLink = new Models.Component(componentConfiguration)
    {
        Type =  ComponentType.General_StandardLink,
        Title = Model.Title,
        Values = new List<object>
        {
            document.FilePath
        },
        Attributes = new Dictionary<string, object>
        {
            { "download", "" }
        }
    };

    var showPublicationDate = Model.Variables?.ContainsKey("showPublicationDate") == true
        && (bool)Model.Variables["showPublicationDate"] == true;

    var publicationDateModel = Model.Clone(newModel =>
    {
        newModel.Type = ComponentType.General_PublishedDate;
        newModel.Values = new List<object>
        {
            document.DocumentPublishedDate
        };
    });
} 
    <div class="download-a-document-container">
        <p class="download-a-document">
            @{ await downloadLink.Render(Html, Model.PageData); }<br>

            <span class="download-a-document-content">
                <span class="download-a-document-section-1">
                    @if (showPublicationDate)
                    {
                        await publicationDateModel.Render(Html, Model.PageData);
                        await ComponentHelper.Render(Html, ComponentType.General_Section, Model, Model.PageData);

                        @if (isLatestDocument && (isFinal != null && !(bool)isFinal))
                        {
                            await ComponentHelper.Render(Html, ComponentType.Tag_Latest, publicationDateModel, Model.PageData);
                        }

                        @if (!isLatestDocument && (isFinal != null && (bool)isFinal))
                        {
                            await ComponentHelper.Render(Html, ComponentType.Tag_Final, publicationDateModel, Model.PageData);
                        };
                        @:<br />
                    }
                    else
                    {
                        await ComponentHelper.Render(Html, ComponentType.General_Section, Model, Model.PageData);
                    }

                    @if (FundingDocumentFileType.Spreadsheet_OpenFormat.Equals(fileExtension, System.StringComparison.InvariantCultureIgnoreCase))
                    {
                        @:OpenDocument Spreadsheet (<abbr title="OpenDocument Spreadsheet">ODS</abbr>),
                    }
                    else if (FundingDocumentFileType.Spreadsheet_CSVFormat.Equals(fileExtension, System.StringComparison.InvariantCultureIgnoreCase))
                    {
                        @:Comma-Separated Values (<abbr title="Comma-Separated Values">CSV</abbr>),
                    }
                    @fileSizeKb<text>KB</text>
                </span>
                <span class="download-a-document-section-2">
                    @if (FundingDocumentFileType.Spreadsheet_OpenFormat.Equals(fileExtension, System.StringComparison.InvariantCultureIgnoreCase))
                    {
                    @:This file is in an <a title="This will open in a new tab or window" href="https://www.gov.uk/guidance/using-open-document-formats-odf-in-your-organisation" target="_blank" rel="external noopener noreferrer">OpenDocument</a> format.
                }
                    
                    You may need a different format if you're using assistive technology. <a class="expand-hidden-section" role="button" aria-expanded="true" aria-controls="attachment-@documentId-accessibility-request" href="#attachment-@documentId-accessibility-request" data-expanded="true" data-controls="attachment-@documentId-accessibility-request">Request an accessible format</a>.
                <span id="attachment-@documentId-accessibility-request" class="hidden-section js-hidden" aria-live="polite" role="region" aria-hidden="true">If you use assistive technology (such as a screen reader) and need a version of this document in a more accessible format, please contact the <a target="_blank" rel="external noopener noreferrer" href='https://customerhelpportal.education.gov.uk' title="This will open in a new tab or window">Customer Help Portal</a><text>. Please tell us what format you need. It will help us if you say what assistive technology you use.</text></span>
                </span>
            </span>
        </p>
    </div>