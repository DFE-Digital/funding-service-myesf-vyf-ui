@*@using PDS.ViewYourFunding.Services.Helper
@using Models = PDS.ViewYourFunding.Services.Interfaces.Models
@model Models.Component
@{
    var configuration = Model.ComponentConfiguration;
    var varianceMessage = configuration.VarianceMessage;
    var (periodStartYear, periodEndYear) = FundingPeriodHelper.GetYearsFromCode(configuration.FundingPeriodCode);
    var url = $"{configuration.UrlForLoggedInView}/variance-selection/{configuration.PrimaryIdentifier}/{configuration.FundingStreamName?.ToUIPathComponent()}/{configuration.StatusChangedDate?.ToString("dd-M-yyyy")}/{periodStartYear}-to-{periodEndYear}";
}
@if (!string.IsNullOrEmpty(varianceMessage))
{
    <div class="govuk-warning-text custom">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            <p class="govuk-font-size-19">

                @varianceMessage

            </p>
            <a href=@url class="govuk-font-size-19">Change statement view</a>
        </strong>
    </div>
}*@