@using PDS.ViewYourFunding.Services.Helper
@using PDS.ViewYourFunding.Services.Enums
@using Models = PDS.ViewYourFunding.Services.Interfaces.Models
@model Models.Component
@{
    var isLatest = Model.GetValue() is bool valueBool ? valueBool : Model.ComponentConfiguration.IsLatestOrFinalFundingForYear;

    if (isLatest)
    {
        await ComponentHelper.Render(Html, ComponentType.Tag_Latest, Model, Model.PageData);
    }
}