@using PDS.ViewYourFunding.Services.Helper
@using PDS.ViewYourFunding.Web.Helpers
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine Engine
@model PDS.ViewYourFunding.Web.Models.ViewYourFunding.FundingBreakdownViewModel

@{
    var viewPath = $"~/Views/ViewYourFunding/Overrides/LocalAuthority{Model.FundingStreamConfiguration.FundingStreamCode}Breakdown.cshtml";

    if (Engine.GetView(viewPath, viewPath, false).Success)
    {
        await Html.RenderPartialAsync(viewPath);
    }
    else
    {
        await Model.FundingViewData?.Components.Render(Html);
    }
}

@section vyfScripts{ @Html.PageScripts() }
