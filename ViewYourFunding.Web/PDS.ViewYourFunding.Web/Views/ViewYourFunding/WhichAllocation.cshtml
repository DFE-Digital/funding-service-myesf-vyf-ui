@using PDS.ViewYourFunding.Web.Models.ViewYourFunding
@model PDS.ViewYourFunding.Web.Models.ViewYourFunding.WhichAllocationViewModel

@using (Html.BeginRouteForm(ViewYourFundingConstants.RouteName_WhichAllocationChosen, FormMethod.Post, new { @class = "transaction" }))
{
    @Html.AntiForgeryToken()
    <div class="error-summary@(Model.ValidationError ? "" : " hidden")" role="alert" aria-labelledby="error-summary-heading" tabindex="-1">
        <h2 class="heading-medium error-summary-heading" id="error-summary-heading">There is a problem</h2>
        <ul class="error-summary-list">
            <li><a href="#fundingAllocation">Select a funding type</a></li>
        </ul>
    </div>

    <fieldset class=@(Model.ValidationError ? "after-error-summary" : "after-hidden-error-summary")>
        <legend id="fundingAllocation" class="govuk-fieldset__legend govuk-fieldset__legend--xl">
            <h1 class="heading-xlarge">@Model.ContentTitle</h1>
        </legend>

        <div class="form-group@(Model.ValidationError ? " form-group-error" : " form-group-no-error")">
            <span class="error-message@(Model.ValidationError ? "" : " hidden")">Select a funding type</span>

            @for (int latestYear = 0; latestYear < Model.LatestYear.Count(); latestYear++)
            {
                <div class="multiple-choice choice-required">
                    <input id="radio-@(latestYear + 1)" type="radio" name="fundingAllocationChoice" value="@Model.LatestYear[latestYear].FundingStreamCode">
                    <label for="radio-@(latestYear + 1)">@Model.LatestYear[latestYear].FundingStreamName</label>
                </div>
            }

        </div>
    </fieldset>

    @await Html.PartialAsync("Partial/_AlternativeFunding")

    <div class="form-group">
        <button class="button" type="submit">Continue</button>
    </div>
}

@section vyfScripts {
    <script>
        var actionMap = {};
        @{
            var optionMap = ViewYourFundingConstants.OptionMap_WhichAllocation(Model.LatestYear);
        }
        @foreach(var key in optionMap.Keys)
        {
            var data = optionMap[key];

            if (data.UseRouteValuesWhenScriptsEnabled)
            {
                @:actionMap["@key"] = "@Url.RouteUrl(data.RouteName, data.RouteValues)";
            }
            else
            {
                @:actionMap["@key"] = "@Url.RouteUrl(data.RouteName)";
            }
        }
    </script>
    <environment names="Development">
        <script src="~/Scripts/multi-form-custom-validation.js" type="text/javascript"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~/js/vyf-custom-multi-form-validation.min.js" asp-file-version="true" type="text/javascript"></script>
    </environment>
}