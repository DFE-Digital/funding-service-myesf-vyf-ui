@using PDS.ViewYourFunding.Services.Enums
@using PDS.ViewYourFunding.Services.Helper
@using PDS.ViewYourFunding.Web.Helpers
@model PDS.ViewYourFunding.Web.Areas.LoggedIn.Models.ProviderStatementViewModel

@{ var instanceNumber = 1; }

@section _AdminScreensLayout_Styles
{
    <link rel="stylesheet" href="~/css/loggedin.min.css" type="text/css" media="screen" />
}

<h1 class="heading-xlarge">Allocation statements</h1>

@if (Model.DisplayNoAllocationMessage)
{
    <p>You do not have any digital allocation statements yet. You will be notified when they are available.</p>
    <p>If you believe this is incorrect, contact the <a href='https://customerhelpportal.education.gov.uk' target="_blank" rel="external noopener noreferrer">Customer Help Portal (opens in a new tab)</a>.</p>
}

<div class="govuk-accordion" data-module="accordion" id="accordion-default">

    @foreach (var fundingStreamCode in Model.FundingViewData.Keys)
    {        
        var fundingStreamData = Model.FundingViewData[fundingStreamCode];
        var header = fundingStreamData.Components?.SingleOrDefault(c => c.Type == ComponentType.Accordion_Button);
        var body = fundingStreamData.Components?.SingleOrDefault(c => c.Type == ComponentType.Accordion_Panel);
        var sharedData = fundingStreamData.Components.FirstOrDefault()?.PageData;

        var data = sharedData != null ? sharedData.ToDictionary(entry => entry.Key, entry => entry.Value) : new Dictionary<string, object>();

        var instance = instanceNumber++;
        if (data.ContainsKey(instance.ToString()))
        {
            data.Add("AccordionInstanceNumber", instance);
        }


        <div class="govuk-accordion__section for-funding-@fundingStreamCode">
            @{
                await header.Render(Html, data);
                await body.Render(Html, data);
            }
        </div>
    }
    @foreach (var fundingStreamCode in Model.ProviderFundingViewData.Keys)
    {
        var fundingStreamData = Model.ProviderFundingViewData[fundingStreamCode];
        var header = fundingStreamData.Components?.SingleOrDefault(c => c.Type == ComponentType.Accordion_Button);
        var body = fundingStreamData.Components?.SingleOrDefault(c => c.Type == ComponentType.Accordion_Panel);
        var sharedData = fundingStreamData.Components.FirstOrDefault()?.PageData;

        var data = sharedData != null ? sharedData.ToDictionary(entry => entry.Key, entry => entry.Value) : new Dictionary<string, object>();
        var instance = instanceNumber++;
        if (data.ContainsKey(instance.ToString()))
        {
            data.Add("AccordionInstanceNumber", instance);
        }


        <div class="govuk-accordion__section for-@fundingStreamCode">
            @{
                await header.Render(Html, data);
                await body.Render(Html, data);
            }
        </div>
    }
</div>

@section vyfScripts {
    @Html.PageScripts()
}