@using PDS.ViewYourFunding.Services.Helper
@using PDS.ViewYourFunding.Web.Helpers

@model PDS.ViewYourFunding.Web.Areas.LoggedIn.ViewModels.Child.ChildHistoryPageViewModel

@section _AdminScreensLayout_Styles
{
    <link rel="stylesheet" href="~/css/loggedin.min.css" type="text/css" media="screen" />
}

@if (Model.DisplayUnauthorisedAccessErrorMessage)
{
    <h1 class="heading-xlarge">You do not have permission<br> to access this page</h1>

    <h2>
        If you think you should have access, contact the organisation or administrator who set up your permissions..
    </h2>
}
else
{
    var components = Model?.FundingViewData?.Components;

    if (components != null)
    {
        await components.Render(Html);
    }
}


@section vyfScripts {
    @Html.PageScripts()
}