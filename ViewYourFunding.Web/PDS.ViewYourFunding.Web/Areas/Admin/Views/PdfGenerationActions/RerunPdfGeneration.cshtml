@using PDS.ViewYourFunding.Web.Models.ViewYourFunding
@model PDS.ViewYourFunding.Web.Areas.Admin.Models.PdfGenerationActions.RerunPdfGenerationViewModel
@{
    var booleanSelectList = new[]
    {
        new SelectListItem { Value = "true", Text = "Yes" },
        new SelectListItem { Value = "false", Text = "No" }
    };
}
<h1 class="govuk-heading-xl">ReRun Document Generation on batch</h1>

@using (Html.BeginRouteForm(ViewYourFundingConstants.RouteName_PdfGenerationActionsRerunPdfGeneration, null, FormMethod.Post, null, new { @class = "submitDisable" }))
{
    @Html.AntiForgeryToken()


    <div class="form-group required">
        @Html.LabelFor(model => model.SinceCreatedDate, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.SinceCreatedDate, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.SinceCreatedDate, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.EndDateTime, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.EndDateTime, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.EndDateTime, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.ResetFunding, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(m => m.ResetFunding, booleanSelectList)
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.ResetProviderFunding, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(m => m.ResetProviderFunding, booleanSelectList)
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.FundingStreamCode, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.FundingStreamCode, Model.FundingStreamCodes, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>
	@Html.HiddenFor(m => m.SinceCreatedDate)
	@Html.HiddenFor(m => m.EndDateTime)
	@Html.HiddenFor(m => m.ResetFunding)
	@Html.HiddenFor(m => m.ResetProviderFunding)
	@Html.HiddenFor(m => m.FundingStreamCode)
    <input type="submit" class="button" value="Rerun Document Generation" />
    @Html.RouteLink("Cancel", ViewYourFundingConstants.RouteName_PdfGenerationActionsHome)
}