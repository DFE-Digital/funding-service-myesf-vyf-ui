    {
        new SelectListItem { Value = "true", Text = "Yes" },
        new SelectListItem { Value = "false", Text = "No" }
    };
}
<h1 class="govuk-heading-xl">ReRun Document Generation on batch</h1>

@using (Html.BeginRouteForm(ViewYourFundingConstants.RouteName_PdfGenerationActionsConfirmRerunPdfGeneration, null, FormMethod.Post, null, new { @class = "submitDisable" }))
{
    @Html.AntiForgeryToken()


<dl class="dl-horizontal-halves">
