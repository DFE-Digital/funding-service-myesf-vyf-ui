@using PDS.ViewYourFunding.Web.Models.ViewYourFunding
@model PDS.ViewYourFunding.Web.Areas.Admin.Models.PdfGenerationActions.GenerateSinglePdfViewModel

<h1 class="govuk-heading-xl">Generate Single Document</h1>

@using (Html.BeginRouteForm(ViewYourFundingConstants.RouteName_PdfGenerationActionsGenerateSinglePdf, null, FormMethod.Post, null, new { @class = "submitDisable" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group required">
        @Html.LabelFor(model => model.ProviderFundingId, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.ProviderFundingId, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.ProviderFundingId, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.FundingStreamCodeAndPeriodCode, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.FundingStreamCodeAndPeriodCode, Model.FundingStreamCodeAndPeriodCodes, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.Ukprn, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Ukprn, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Ukprn, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.CutOffDate, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.CutOffDate, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CutOffDate, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.ProviderType, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.ProviderType, Model.ProviderTypes, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>
    <div class="form-group required">
        @Html.LabelFor(model => model.ProviderSubType, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.ProviderSubType, Model.ProviderSubTypes, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>

    <input type="submit" class="button" value="Submit" />
    @Html.RouteLink("Cancel", ViewYourFundingConstants.RouteName_PdfGenerationActionsHome)
}