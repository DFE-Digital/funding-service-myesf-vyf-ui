@using PDS.ViewYourFunding.Web.Models.ViewYourFunding
@model PDS.ViewYourFunding.Web.Areas.Admin.Models.PdfGenerationActions.GenerateFundingReportsViewModel

<h1 class="govuk-heading-xl">Generate Funding Report</h1>

@using (Html.BeginRouteForm(ViewYourFundingConstants.RouteName_PdfGenerationActionsGenerateFundingReports, null, FormMethod.Post, null, new { @class = "submitDisable" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.ReportType, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.ReportType, Model.ReportTypes, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.FundingPeriodCode, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.FundingPeriodCode, Model.FundingPeriodCodes, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>

    <input type="submit" class="button" value="Generate Report" />
    @Html.RouteLink("Cancel", ViewYourFundingConstants.RouteName_PdfGenerationActionsHome)
}