@model PDS.ViewYourFunding.Web.Areas.Admin.Models.DataTypeEdit.TimeTypeEdit

<div class="form-horizontal">
    <div class="form-group required">
        <div class="group gds-datepicker">
            @Html.ValidationMessageFor(model => model.Hour, null, new {@class = "text-danger"})
            @Html.ValidationMessageFor(model => model.Minute, null, new {@class = "text-danger"})
            <div class="form-group-day">
                <label class="form-label">
                    Hour
                    @Html.EditorFor(model => model.Hour, new {htmlAttributes = new {@class = "form-control"}})
                </label>
            </div>
            <div class="form-group-month">
                <label class="form-label">
                    Minutes
                    @Html.EditorFor(model => model.Minute, new {htmlAttributes = new {@class = "form-control"}})

                </label>
            </div>
        </div>
    </div>
</div>