<table class="govuk-table">
    <caption class="govuk-table__caption tableCaption">Local Authority View</caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">@Html.LabelFor(model => model.LocalAuthoritySummaryLayoutId)</th>
            <th scope="col" class="govuk-table__header">@Html.LabelFor(model => model.LocalAuthorityFundingBreakdownLayoutId)</th>
            <th scope="col" class="govuk-table__header">@Html.LabelFor(model => model.LocalAuthorityHistoryLayoutId)</th>
            <th scope="col" class="govuk-table__header">@Html.LabelFor(model => model.LocalAuthorityHistorySingleYearLayoutId)</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">
                @Model.LayoutUiModels.GetLayoutName(Model.LocalAuthoritySummaryLayoutId)
            </td>
            <td class="govuk-table__cell">
                @Model.LayoutUiModels.GetLayoutName(Model.LocalAuthorityFundingBreakdownLayoutId)
            </td>
            <td class="govuk-table__cell">
                @Model.LayoutUiModels.GetLayoutName(Model.LocalAuthorityHistoryLayoutId)
            </td>
            <td class="govuk-table__cell">
                @Model.GetLayoutName(Model.LocalAuthorityHistorySingleYearLayoutId)
            </td>
        </tr>
    </tbody>
</table>

<table class="govuk-table">
