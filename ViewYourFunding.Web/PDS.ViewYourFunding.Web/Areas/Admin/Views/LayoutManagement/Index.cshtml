@using PDS.ViewYourFunding.Web.Models.ViewYourFunding
@model PDS.ViewYourFunding.Web.Areas.Admin.Models.LayoutManagement.LayoutManagementHomePageViewModel

<script>
     var pageNumber = "@Model.Pagination.PageNumber";
</script>

@using (Html.BeginRouteForm(ViewYourFundingConstants.RouteName_AdminLayoutManagementHome, null, FormMethod.Post))
{

    <div class="grid-row">
        <div class="column-full">
            @* Dynamic alert for screen readers so users know when the filtered results have been updated *@
            <div class="visuallyhidden" role="alert" aria-labelledby="filter-results-updated">
                <h2 id="filter-results-updated" class="pager-summary">Results updated, now showing 1 to 10 of 10 allocation statements</h2>
            </div>
            <div class="column-filter-one-third column-third" style="float: left;">
                <div class="form-block">
                    <fieldset class="filter">
                        <legend class="visuallyhidden">Funding stream</legend>
                        <div class="js-filter-collapsible-collections">
                            <section id="type-filter" class="js-filter-collapsible js-open">
                                <input type="hidden" name="queryFilterOpenType" id="queryFilterOpenType" aria-expanded="true" aria-controls="filter-by-type" value="true">
                                <a href="#" id="filter-keyboard-type" class="filter-keyboard" type="button" aria-expanded="true" aria-controls="filter-by-type">
                                    <header id="type" class="js-filter-collapsible-header">
                                        <h2 class="filters-headings heading-small">Funding stream</h2>
                                    </header>
                                </a>
                                <div id="filter-by-type" class="js-filter-collapsible-content" aria-labelledby="type">
                                    <section class="toggled-adult-funding-content group">
                                        <ul>
                                            @foreach (var fundingStreamFilter in Model.LayoutFilter.FundingStreams)
                                            {
                                                <li class="gds-multiple-choice multiple-choice myesf-filter">
                                                    <input type="checkbox" class="chk-funding-streams" id="FilterType.FundingStreams.@fundingStreamFilter.Id" name="Model.FilterType.FundingStreams" value="@fundingStreamFilter.Id" @{if (fundingStreamFilter.Selected) { <text> checked="checked" </text>  } } />

                                                    <label class="block" for="FilterType.FundingStreams.@fundingStreamFilter.Id">@fundingStreamFilter.Name</label>
                                                </li>
                                            }

                                        </ul>
                                    </section>
                                </div>
                            </section>
                        </div>
                    </fieldset>
                    <fieldset class="filter">
                        <legend class="visuallyhidden">Funding view type</legend>
                        <div class="js-filter-collapsible-collections">
                            <section id="type-filter" class="js-filter-collapsible js-open">
                                <input type="hidden" name="queryFilterOpenType" id="queryFilterOpenType" aria-expanded="true" aria-controls="filter-by-type" value="true">
                                <a href="#" id="filter-keyboard-type" class="filter-keyboard" type="button" aria-expanded="true" aria-controls="filter-by-type">
                                    <header id="type" class="js-filter-collapsible-header">
                                        <h2 class="filters-headings heading-small">Funding view type</h2>
                                    </header>
                                </a>
                                <div id="filter-by-type" class="js-filter-collapsible-content" aria-labelledby="type">
                                    <section class="toggled-adult-funding-content group">
                                        <ul>
                                            @foreach (var fundingViewTypeFilter in Model.LayoutFilter.FundingViewTypes)
                                            {
                                                <li class="gds-multiple-choice multiple-choice myesf-filter">
                                                    <input type="checkbox" class="chk-funding-view-types" id="FilterType.FundingViewTypes.@fundingViewTypeFilter.Id" name="Model.FilterType.FundingViewTypes" value="@fundingViewTypeFilter.Id" @{if (fundingViewTypeFilter.Selected) { <text> checked="checked" </text>  } } />
                                                    <label class="block" for="FilterType.FundingViewTypes.@fundingViewTypeFilter.Id">@fundingViewTypeFilter.Name</label>
                                                </li>
                                            }
                                        </ul>
                                    </section>
                                </div>
                            </section>
                        </div>
                    </fieldset>
                    <fieldset class="filter">
                        <legend class="visuallyhidden">Layout type</legend>
                        <div class="js-filter-collapsible-collections">
                            <section id="scope-filter" class="js-filter-collapsible js-open">
                                <input type="hidden" name="queryFilterOpenScope" id="queryFilterOpenScope" aria-expanded="true" aria-controls="filter-by-scope" value="true">
                                <a href="#" id="filter-keyboard-scope" class="filter-keyboard" type="button" aria-expanded="true" aria-controls="filter-by-scope">
                                    <header id="scope" class="js-filter-collapsible-header">
                                        <h2 class="filters-headings heading-small">Layout type</h2>
                                    </header>
                                </a>
                                <div id="filter-by-scope" class="js-filter-collapsible-content" aria-labelledby="scope">
                                    <section class="toggled-adult-funding-content group">
                                        <ul>
                                            @foreach (var fundingViewScopeFilter in Model.LayoutFilter.FundingViewScopes)
                                            {
                                                <li class="gds-multiple-choice multiple-choice myesf-filter">
                                                    <input type="checkbox" class="chk-funding-view-scopes" id="FilterType.FundingViewScopes.@fundingViewScopeFilter.Id" name="Model.FilterType.FundingViewScopes" value="@fundingViewScopeFilter.Id" @{if (fundingViewScopeFilter.Selected) { <text> checked="checked" </text>  } } />
                                                    <label class="block" for="FilterType.FundingViewScopes.@fundingViewScopeFilter.Id">@fundingViewScopeFilter.Name</label>
                                                </li>
                                            }
                                        </ul>
                                    </section>
                                </div>
                            </section>
                        </div>
                    </fieldset>
                </div>

                <div id="postButton" class="form-group" aria-hidden="true">
                    <button name="Model.FilterType.UpdateFilters" class="button" type="submit">Update results</button>
                </div>

                <div id="clearAllFilters" class="form-group">
                    @Html.RouteLink(ViewYourFundingConstants.LinkText_ResetSearchFilter, ViewYourFundingConstants.RouteName_AdminLayoutManagementHome, null, new { id = "ResetSearch" })
                </div>
            </div>
            <div class="column-two-thirds">
                <div class="form-group">
                    <dl class="row">
                        <dt class="column-half">Import layout file</dt>
                        <dd class="column-half">@Html.RouteLink("Import layout Json", ViewYourFundingConstants.RouteName_AdminLayoutImport, null, new { @class = "button", role = "button", draggable = "false" }) </dd>
                    </dl>
                </div>
                <div class="visuallyhidden" role="alert" aria-labelledby="filter-results">
                    <span id="filter-results" class="pager-summary">Showing 1 to 10 of 10 allocation statements</span>
                </div>
                <table class="touch-table">
                    <tr>
                        <th>Layout Template</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>

                    <tr><td colspan="3" class="@(@Model.Pagination.ResultCount  == 0 ? "no-records" : "no-records hidden")"> No layouts found. Please amend your criteria. </td></tr>

                    @Html.DisplayFor(model => model.LayoutModels)
                </table>

                <div class="pager" aria-hidden="false" data-paging="">
                    @if (Model.Pagination.ResultCount >= Model.Pagination.PageSize)
                    {
                        <div class="pager-controls">
                            <input name="Pagination.CurrentPage" type="hidden" id="currPage" value="@Model.Pagination.PageNumber" />
                            <input type="submit" value="Previous" name="Pagination.Previous" class="@(@Model.Pagination.HasPreviousPage ? "linkButton" : "hidden linkButton")" id="prevPage" />
                            <span class="pages">
                                @for (int pageNo = Model.Pagination.FirstPage; pageNo <= Model.Pagination.LastPage; pageNo++)
                                {
                                    <input type="@(@Model.Pagination.PageNumber == pageNo ? "button" : "submit")" name="Pagination.PageNumber" value="@pageNo" class="@(@Model.Pagination.PageNumber == pageNo ? "currentLink" : "linkButton linkPage")" />
                                }
                            </span>
                            <input type="submit" value="Next" name="Pagination.Next" class="@(@Model.Pagination.HasNextPage ? " pager-next linkButton" : " hidden pager-next linkButton")" id="nextPage" />
                        </div>
                    }
                    <div id="pgSummary" class="pager-summary">Showing @Model.Pagination.FirstRecordNo to @Model.Pagination.LastRecordNo of @Model.Pagination.ResultCount layouts</div>
                </div>


                @if (Model.LayoutModels.Count == Model.Pagination.PageSize)
                {
                    <div class="form-group direction-rtl">
                        <a class="app-c-back-to-top dont-print back-to-top-link" href="#content">
                            <svg class="app-c-back-to-top__icon" xmlns="http://www.w3.org/2000/svg" width="13" height="17" viewBox="0 0 13 17">
                                <path fill="currentColor" d="M6.5 0L0 6.5 1.4 8l4-4v12.7h2V4l4.3 4L13 6.4z"></path>
                            </svg>
                            Back to top
                        </a>
                    </div>
                }

            </div>
        </div>
    </div>
}

@section adminScripts
{
    <environment names="Development">
        <script src="~/Scripts/layout-pagination.js" type="text/javascript"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~/js/layout-pagination.min.js" asp-file-version="true" type="text/javascript"></script>
    </environment>
}