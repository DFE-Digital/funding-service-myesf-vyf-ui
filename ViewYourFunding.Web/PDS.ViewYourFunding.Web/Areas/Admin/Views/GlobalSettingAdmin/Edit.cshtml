@using PDS.ViewYourFunding.Web.Models.ViewYourFunding
@model PDS.ViewYourFunding.Web.Areas.Admin.Models.DataTypeEdit.DataTypeBaseEdit

<p>
    <span class="heading-large">Edit General Setting</span>
</p>

<p>
    <span class="heading-medium">@Model.Description</span>
</p>
<div>
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.CurrentValue)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CurrentValue)
        </dd>
    </dl>
</div>
@{
    using (Html.BeginRouteForm(ViewYourFundingConstants.RouteName_AdminGeneralSettingEdit, null, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.EditorFor(model => model, Model.EditTemplateName)
        
        <input type="submit" class="button" />

        @Html.HiddenFor(model => model.EditTemplateName)
        @Html.HiddenFor(model => model.SettingEditType)
        @Html.HiddenFor(model => model.Description)
        @Html.HiddenFor(model => model.DataTypeId)
        @Html.HiddenFor(model => model.CurrentValue)
    }
}