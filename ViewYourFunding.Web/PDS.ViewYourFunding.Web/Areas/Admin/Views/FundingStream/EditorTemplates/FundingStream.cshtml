            @Html.EditorFor(model => model.FundingStreamCode, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.FundingStreamCode, "", new { @class = "text-danger" })
        </div>
    </div>

