@using PDS.ViewYourFunding.Web.Areas.Admin.Models.FundingStream
@model PDS.ViewYourFunding.Web.Areas.Admin.Models.FundingStream.ActionMode
@switch (Model)
{
    case ActionMode.Add:
        <p>
            <span class="heading-large">Add Funding Stream</span>
        </p>
        break;
    case ActionMode.Delete:
